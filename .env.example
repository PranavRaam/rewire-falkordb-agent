REWIRE_FALKOR_HOST=127.0.0.1
REWIRE_FALKOR_PORT=6379
# Leave blank if this local instance has no password.
REWIRE_FALKOR_USERNAME=
REWIRE_FALKOR_PASSWORD=
REWIRE_SCENARIO=base
# Phase 4 local model runtime (Ollama is the default).
REWIRE_LLM_PROVIDER=ollama
REWIRE_LLM_MODEL=qwen3.5:4b
# Ollama OpenAI-compatible endpoint. Override only when needed.
REWIRE_LLM_BASE_URL=http://127.0.0.1:11434/v1/chat/completions
# Ollama ignores this local placeholder; OpenAI mode uses OPENAI_API_KEY below.
REWIRE_LLM_API_KEY=ollama
REWIRE_LLM_CONTEXT=4096
REWIRE_LLM_MAX_TOKENS=384
REWIRE_LLM_TIMEOUT_SECONDS=300
# Optional remote mode. Leave blank for local Ollama.
OPENAI_API_KEY=
